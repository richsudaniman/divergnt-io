{
  "name": "BrainDump",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "User-provided title for the brain dump session."
    },
    "canvas_data_json": {
      "type": "string",
      "description": "JSON string representing the state of the infinite canvas (elements, positions, zoom, etc.)."
    },
    "raw_text_content": {
      "type": "string",
      "description": "A plain text aggregation of all text content from the canvas, used for AI processing."
    },
    "audio_file_url": {
      "type": "string",
      "description": "URL to the full, raw audio recording file."
    },
    "image_file_urls": {
      "type": "array",
      "description": "An array of URLs for all uploaded images and sketches.",
      "items": {
        "type": "string"
      }
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "raw",
        "transcribing",
        "analyzing",
        "processed",
        "error"
      ],
      "default": "raw",
      "description": "Tracks the current stage of the AI processing pipeline."
    },
    "linked_exam_id": {
      "type": "string",
      "description": "ID of the Exam (acting as a class/project folder) this dump is connected to."
    },
    "processed_notes_markdown": {
      "type": "string",
      "description": "The final, organized notes generated by the AI in Markdown format."
    },
    "extracted_concepts": {
      "type": "array",
      "description": "Core concepts and ideas identified by the AI.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "related_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "extracted_action_items": {
      "type": "array",
      "description": "A list of clear, actionable tasks extracted from the dump.",
      "items": {
        "type": "string"
      }
    },
    "identified_patterns": {
      "type": "array",
      "description": "Personal thinking patterns (metaphors, analogies, confusions) identified by the AI.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "metaphor",
              "analogy",
              "confusion_point"
            ]
          },
          "original_phrase": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "cross_referenced_materials": {
      "type": "array",
      "description": "Links to other study materials related to this dump's content.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "video_notes",
              "exam_material",
              "study_section"
            ]
          },
          "title": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          }
        }
      }
    },
    "raw_text_timestamp_map": {
      "type": "array",
      "description": "Mapping of transcribed text segments to their original audio timestamps.",
      "items": {
        "type": "object",
        "properties": {
          "text_segment": {
            "type": "string"
          },
          "start_time": {
            "type": "number"
          },
          "end_time": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": []
}